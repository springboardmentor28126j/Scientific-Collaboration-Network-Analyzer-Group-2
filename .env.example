# --- App ---
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="Scientific Research Management System"
API_V1_PREFIX=/api/v1

# --- Security ---
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/research_db

# --- Superuser bootstrap (created on startup if it doesn't exist) ---
SUPERUSER_EMAIL=admin@platform.com
SUPERUSER_PASSWORD=changeme123
SUPERUSER_FULL_NAME="Platform Super Admin"

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Mail (MailCatcher in dev; real SMTP provider in prod) ---
MAIL_USERNAME=noreply
MAIL_PASSWORD=noreply
MAIL_FROM=noreply@platform.com
MAIL_FROM_NAME="Research Management System"
MAIL_SERVER=mailcatcher
MAIL_PORT=1025
MAIL_STARTTLS=False
MAIL_SSL_TLS=False
MAIL_USE_CREDENTIALS=False
MAIL_VALIDATE_CERTS=False

# --- Frontend (used to build links embedded in emails) ---
FRONTEND_URL=http://localhost:3000

# --- CORS ---
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
