# Copy these settings into .env. Keep .env private and never commit its values.
DATABASE_URL=postgresql://your-database-url
SECRET_KEY=replace-with-a-long-random-secret
APP_URL=http://127.0.0.1:5173

# Resend professional email delivery. Verify the sender/domain in Resend first.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=SCNA Notifications <notifications@your-verified-domain.com>
