# Copy these settings into .env. Keep .env private and never commit its values.
DATABASE_URL=postgresql://your-database-url
SECRET_KEY=replace-with-a-long-random-secret
APP_URL=http://127.0.0.1:5173
BACKEND_URL=http://127.0.0.1:8000

# Optional social login. Register these callback URLs in Google Cloud / Microsoft Entra:
# http://127.0.0.1:8000/users/oauth/google/callback
# http://127.0.0.1:8000/users/oauth/microsoft/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Free local AI assistant. Install Ollama and download the selected model once.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b

# Resend professional email delivery. Verify the sender/domain in Resend first.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=SCNA Notifications <notifications@your-verified-domain.com>
