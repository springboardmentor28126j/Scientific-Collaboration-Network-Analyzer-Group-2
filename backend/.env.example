
# Cloud (Supabase) example — get your own connection string from Supabase Project Settings > Database > Direct connection > URI
DATABASE_URL=postgresql+psycopg://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres?sslmode=require

# Local Postgres alternative:
# DATABASE_URL=postgresql+psycopg://scna_user:scna_password@localhost:5432/scna

JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Outbound email (collaboration-request notifications, etc.). Leave
# SMTP_HOST blank to run without real email -- send_email() will just log
# a 'would have sent' warning instead of failing the request.
# Example for Gmail: host=smtp.gmail.com, port=587, use an App Password
# (not your normal Gmail password) for SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@scna.local
SMTP_FROM_NAME=SCNA

# reCAPTCHA v2 checkbox on the login page. These are Google's official
# public TEST keys -- they always pass verification and work on any
# host including localhost, so login works out of the box in dev.
# Replace with your own keys from https://www.google.com/recaptcha/admin
# before a real deployment (register your real domain there).
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
