
# Cloud (Supabase) example — get your own connection string from Supabase Project Settings > Database > Direct connection > URI
DATABASE_URL=postgresql+psycopg://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres?sslmode=require

# Local Postgres alternative:
# DATABASE_URL=postgresql+psycopg://scna_user:scna_password@localhost:5432/scna

JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
