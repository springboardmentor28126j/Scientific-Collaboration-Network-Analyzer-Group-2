# Copy this file to .env and fill in real values. .env is gitignored.

# URL of the FastAPI backend.
BACKEND_URL=http://127.0.0.1:8000

# Flask session signing key. Any random string is fine for local dev.
FLASK_SECRET_KEY=dev-secret-change-me

# reCAPTCHA v2 checkbox site key shown on the login page. Must be the
# public counterpart of whatever RECAPTCHA_SECRET_KEY the backend has
# configured (see backend/.env.example) -- same Google site registration
# on both ends, or verification will always fail.
#
# Defaults to Google's official public TEST site key if left unset,
# which always passes but shows a "for testing purposes only" banner.
# Get your own free key pair (registered for the "localhost" domain) at
# https://www.google.com/recaptcha/admin/create to remove that banner.
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
